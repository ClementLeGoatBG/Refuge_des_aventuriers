<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
     <t t-name="refuge_aventuriers.SpiritLine">
        <div class="spirit-item" t-on-click="props.onClick">
            <div class="spirit-image-container">
                <img t-if="props.imageUrl" t-att-src="props.imageUrl" alt="Product Image" class="spirit-image" />
                <div class="spirit-image-placeholder">
                    <i class="fa fa-spirit" aria-hidden="true"></i>
                </div>
            </div>
            <div class="spirit-details">
                <div class="spirit-name"><t t-esc="props.name" /></div>
                <div class="spirit-price"><t t-esc="formatPrice(props.spiritPrice)" /></div>
            </div>
        </div>
    </t>
</templates>