<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
     <t t-name="refuge_aventuriers.CocktailLine">
         <tr t-on-click="props.onClick">
             <td class="cocktail-list-name"><t t-esc="props.name" />
                 <img t-if="props.imageUrl" t-att-src="props.imageUrl" alt="Product Image" class="cocktail-image" />
             </td>
             <td class="cocktail-list-name"><t t-esc="props.name" />
            </td>
            <td class="cocktail-list-price"><t t-esc="props.cocktailPrice" /> €
            </td>
         </tr>
    </t>
</templates>