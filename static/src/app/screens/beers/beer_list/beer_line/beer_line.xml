<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="refuge_aventuriers.BeerLine">
        <div class="beer-item" t-on-click="props.onClick">
            <div class="beer-image-container">
                <img t-if="props.imageUrl" t-att-src="props.imageUrl" alt="Product Image" class="beer-image" />
                <div t-if="!props.imageUrl" class="beer-image-placeholder">
                    <i class="fa fa-beer" aria-hidden="true"></i>
                </div>
            </div>
            <div class="beer-details">
                <div class="beer-name"><t t-esc="props.name" /></div>
                <div class="beer-price">
                    <t t-esc="formatPrice(props.beerPrice)" />
                    <button t-on-click="props.onAddToCart" class="cart-button" aria-label="Ajouter au panier">
                        <i class="fa fa-cart-plus" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>

